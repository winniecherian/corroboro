# All optional. Corroboro works with none of these set.

# Claude writes neutral headlines and 2-line summaries for the top stories.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# X (Twitter) trending topics. X API is pay-per-use, so leave blank until you set a spend cap.
X_BEARER_TOKEN=
X_WOEID=1
X_REGION=global

# How often feeds refresh, in seconds
REFRESH_SECONDS=600
